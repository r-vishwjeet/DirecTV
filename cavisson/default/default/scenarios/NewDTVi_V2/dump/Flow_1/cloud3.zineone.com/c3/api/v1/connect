n\n                // let bannerConfigLocalKeys = [\"z1_rto_banner_config\"];\n\n                // let bannerConfig = null;\n\n                // for (let i = 0; i < bannerConfigLocalKeys.length; i++) {\n                //     let key = bannerConfigLocalKeys[i];\n                //     let localStorageValue = localStorage.getItem(key);\n\n                //     if (localStorageValue && util.isValid(localStorageValue)) {\n                //         try {\n                //             bannerConfig = JSON.parse(localStorageValue);\n                //             break;\n                //         } catch (e) {\n                //             // Skip\n                //         }\n                //     }\n                // }\n\n                // z1log(\"bannerConfig from codeLibraryTag: \", bannerConfig);\n                // let bannerData = bannerConfig && bannerConfig.bannerData ? bannerConfig.bannerData : null;\n                // z1log(\"bannerData from codeLibraryTag: \", bannerData);\n                // let group = bannerData && bannerData.group ? bannerData.group : bannerConfig && bannerConfig.group ? bannerConfig.group : null;\n                // z1log(\"group from codeLibraryTag: \", group);\n                // if (identifier && identifier === 'SCORED') {\n                //     group = \"NA\";\n                // }\n                // let offerValue = bannerData && bannerData.offerValue ? bannerData.offerValue : \"NA\";\n                // let offerCode = bannerData && bannerData.offerCode ? bannerData.offerCode : \"NA\"\n                // let dataFieldObject = { \"offerValue\": offerValue, \"offerCode\": offerCode };\n                // useCaseName = useCaseName ? useCaseName : bannerConfig.useCaseName;\n                // z1log(\"useCaseName from codeLibraryTag: \", useCaseName);\n                // z1log(\"fireRTOAnalyticsEvent Pushing Analytics Data via window object\");\n                // if (identifier && identifier !== \"SCORED\" && useCaseName && group) {\n                //     let analyticEventObject = {\n                //         \"useCaseName\": useCaseName,\n                //         \"identifier\": identifier,\n                //         \"group\": group,\n                //         \"profileIdField\": connectData && connectData.profileId ? connectData.profileId : 'NA',\n                //         \"data\": JSON.stringify(dataFieldObject)\n                //     }\n                //     let analyticEvent = new CustomEvent('z1_analytic', { detail: analyticEventObject });\n                //     window.dispatchEvent(analyticEvent);\n\n                //     z1log(\"Payload for window object: \", analyticEventObject);\n                // }\n                // else {\n                //     z1log(\"Payload for window object not sent\");\n                // }\n            }\n        };\n\n        z.analytics = new z.Analytics(z.pubsub); //initiliaze a namespace level analytics instance\n\n        z.RTOBannerLifeCycle = {\n            SHOWN: \"SHOWN\",\n            NOTSHOWN: \"NOTSHOWN\",\n            APPLIED: \"APPLIED\",\n            COPIED: \"COPIED\",\n            REDEEMED: \"REDEEMED\",\n            EXPIRED: \"EXPIRED\",\n            CLOSED: \"CLOSED\",\n            SCORED: \"SCORED\"\n        };\n        z.Banner = function (bannerConfig, elem) {\n            let self = this;\n            self.state = \"\";\n            self.bannerConfig = bannerConfig;\n            self.elem = elem;\n            self.render = function (customRender) {\n                if (typeof customRender === \"function\") {\n                    customRender(self);\n                }\n                z1log(\"Attaching click to close\", util.isElement(self.elem));\n                if (util.isElement(self.elem)) {\n                    let closeBtn = self.elem.querySelector(\"#z1_front_closeBtn\");\n                    let backCloseBtn = self.elem.querySelector(\"#z1_back_closeBtn\");\n                    if (closeBtn) {\n                        closeBtn.addEventListener(\"click\", (e) => {\n                            e.stopPropagation();\n                            e.preventDefault();\n                            self.close();\n                        });\n                    }\n                    if (backCloseBtn) {\n                        backCloseBtn.addEventListener(\"click\", (e) => {\n                            e.stopPropagation();\n                            e.preventDefault();\n                            self.close();\n                        });\n                    }\n                    if (util.getDeviceType() == \"phone\") {\n                        let greyArea = self.elem.querySelector(\"div.z1-fixed-container\");\n                        if (greyArea) {\n                            greyArea.addEventListener(\"click\", (e) => {\n                                e.stopPropagation();\n                                e.preventDefault();\n                                self.close();\n                            });\n                        }\n                    }\n                }\n                self.state = z.RTOBannerLifeCycle.SHOWN;\n            };\n            self.close = function (customClose) {\n                let shouldPublish = true;\n                self.state = z.RTOBannerLifeCycle.CLOSED;\n                if (typeof customClose === \"function\") {\n                    shouldPublish = customClose(self);\n                }\n                let z1WidgetDiv = document.getElementById(z.z1WidgetDivId);\n                if (z1WidgetDiv) {\n                    z1WidgetDiv.innerHTML = \"\";\n                }\n                shouldPublish =\n                    shouldPublish == null ? true : shouldPublish + \"\" === \"true\";\n                if (shouldPublish) {\n                    let { useCaseName, actionName, offerCode, entityName } = { ...self.bannerConfig.bannerData };\n                    z.pubsub.publish(z.RTOBannerLifeCycle.CLOSED, {\n                        identifier: z.RTOBannerLifeCycle.CLOSED,\n                        useCaseName,\n                        actionName,\n                        offerCode,\n                        entityName\n                    });\n                }\n            };\n        };\n\n        //init executions\n        (function () {\n            util.attachZ1RawDataHandler();\n        })();\n    } catch (ex) {\n        console.error(\"z1taglib : \", ex);\n    }\n})(window.z1taglib = window.z1taglib || {});"},{"tagName": "collectData","actionType": "z1script","script": "(function (z, undefined) {\n    try {\n        let QA = false;\n        QA = localStorage.getItem(\"z1_qa\") ? localStorage.getItem(\"z1_qa\") === \"true\" : false;\n        // if (!QA) {\n        //     return false;\n        // }\n\n        const util = new z1taglib.Util();\n        const dl = new z1taglib.DataLayerHelper();\n        const eventEnum = z1taglib.EventEnum;\n        const commonEventData = new z1taglib.CommonEventData();\n        const eventFactory = new z1taglib.EventFactory();\n        const cartLocalStorageName = \"z1_cartProducts\";\n        const currentBasePackageSkuKey = \"z1_currentBasePackageSku\";\n\n        // Create Maps\n        const cartViewOfProductFieldMap = {\n            category: \"category\",\n            sku: \"sku\",\n            product_id: \"product_id\",\n            list_price: \"list_price\",\n            price: \"price\",\n            quantity: \"quantity\"\n        };\n\n        const categoryCleanUp = (category = \"\") => { return encodeURIComponent(String(category).toLowerCase().trim()); };\n\n        const isUserOnPackagesShopURL = (pageURL = '') => {\n            let inputURL = pageURL.endsWith('/') ? pageURL.slice(0, -1) : pageURL;\n            const validPaths = ['/shop/dtvi/entertainment-package', '/shop/dtvi/choice-package', '/shop/dtvi/ultimate-package', '/shop/dtvi/premier-package',\n                '/shop/dtvs/entertainment-package', '/shop/dtvs/choice-package', '/shop/dtvs/ultimate-package', '/shop/dtvs/premier-package'];\n\n            const isOnCartPage = validPaths.includes(inputURL);\n            return isOnCartPage;\n        }\n\n        // Function add listeners on \"i\" icon and fire view_cart event if user waits for X seconds on the \"i\" icon\n        const addListenerOnCartPage = () => {\n            const deviceType = util.getDeviceType();\n            if (deviceType === \"phone\" || deviceType === \"tablet\") {\n                // return false;\n                const cartSummaryElement = document.querySelector('#menuBar a.MuiButton-root[role=\"button\"][aria-expanded=\"false\"]');\n\n                if (cartSummaryElement) {\n                    cartSummaryElement.addEventListener('click', () => {\n                        // Wait for DOM to update\n                        setTimeout(() => {\n                            const updatedCartSummaryElement = document.querySelector('#menuBar a.MuiButton-root[role=\"button\"][aria-expanded=\"true\"]');\n                            if (updatedCartSummaryElement) {\n                                const describedBy = updatedCartSummaryElement.getAttribute('aria-describedby');\n                                if (describedBy === 'short-cart') {\n                                    cartPage.sendEvent();\n                                }\n                            }\n                        }, 100);\n                    });\n                }\n            }\n\n            if (deviceType === 'tablet') {\n                let isPackageElementPresent = document.querySelector(\"#sideRail div span\");\n                if (!isPackageElementPresent) return false;\n\n                const cartElements = document.querySelectorAll(\"#sideRail div p.MuiTypography-root span\");\n                cartElements.forEach(element => {\n                    element.addEventListener('click', (e) => {\n                        e.preventDefault();\n                        cartPage.sendEvent();\n                    });\n                });\n                return;\n            }\n\n            const elements = document.querySelectorAll(\"#sideRail div p.MuiTypography-root span\");\n            elements.forEach(element => {\n                let hoverTimeout;\n                let hasPrinted = false;\n\n                element.addEventListener(\"mouseenter\", () => {\n                    hasPrinted = false;\n                    hoverTimeout = setTimeout(() => {\n                        cartPage.sendEvent();\n                        hasPrinted = true;\n                    }, 1000);\n                });\n\n                element.addEventListener(\"mouseleave\", () => {\n                    clearTimeout(hoverTimeout);\n                    hasPrinted = false;\n                });\n            });\n        }\n\n        // const sendDummyAnalyticsDataToCustomer = () => {\n        //     try {\n        //         const z1DeviceId = localStorage.getItem(\"z1_connectData\") ? JSON.parse(localStorage.getItem(\"z1_connectData\")).id : '';\n        //         const z1SessionId = localStorage.getItem(\"z1_sessionData\") ? JSON.parse(localStorage.getItem(\"z1_sessionData\")).z1_session_id : '';\n        //         const z1CustomerId = util.getCookie('BAN') || z1DeviceId;\n        //         const eppLabelArray = ['ULB', 'OTF', 'HLB']\n        //         const randomIndex = Math.floor(Math.random() * eppLabelArray.length);\n        //         const eppLabelValue = eppLabelArray[randomIndex] + '';\n        //         const dataObj = {\n        //             \"score\": Math.random().toFixed(15),\n        //             \"eppLabel\": eppLabelValue,\n        //             \"deviceId\": z1DeviceId,\n        //             \"sessionId\": z1SessionId,\n        //             \"customerId\": z1CustomerId\n        //         };\n        //         const analyticEvent = new CustomEvent(\"z1_analytic\", { detail: dataObj });\n        //         window.dispatchEvent(analyticEvent);\n        //         // z1log(\"z1_analytic event dispatched with payload : \", dataObj);\n        //         util.pushEvent(\"captureAnalyticsDataSentToCustomer\", dataObj);\n        //     }\n        //     catch (ex) {\n        //         console.log(\"Error in sendDummyAnalyticsDataToCustomer : \", ex);\n        //     }\n        // }\n\n        const buildCommonEventData = () => {\n            currentUserObj.init();\n            let currentUser = currentUserObj.info();\n            commonEventData.cart = JSON.stringify(\n                Object.values(util.convertObjectValuesToString(util.transformObjectArray(cart.get(), cartViewOfProductFieldMap)))\n            );\n            commonEventData.logged_in = currentUser.loggedInStatus;\n        };\n\n        const setCustomerId = () => {\n            currentUserObj.init();\n            let currentUser = currentUserObj.info();\n            if (currentUser.customerId && currentUser.customerId !== '') { window.ZineOne && ZineOne.setCustomerId(currentUser.customerId); }\n        };\n\n        function Cart(cartLocalStorageKey = cartLocalStorageName) {\n            this.init = () => { this.cartProducts = {}; };\n            this.displayCart = () => { z1log(JSON.stringify(this.cartProducts)); };\n            this.get = () => {\n                this.cartProducts = localStorage.getItem(cartLocalStorageKey) ? JSON.parse(localStorage.getItem(cartLocalStorageKey)) : {};\n                return this.cartProducts;\n            };\n\n            this.reSyncCart = () => {\n                z1log(\"cartProducts BEFORE resync : \", this.get());\n                let cartProducts = {};\n                const pageData = __NEXT_DATA__?.props?.pageProps || {};\n                const productType = pageData?.productType || '';\n                const cartElements = document.querySelectorAll(\"#sideRail div p.MuiTypography-root\");\n                let sku = '';\n                let dataSource = {};\n\n                if (productType === \"stream\") {\n                    dataSource = localStorage.getItem('stream') ? JSON.parse(localStorage.getItem('stream')) : {};\n\n                    // CDVR\n                    const cloudDVR = dataSource?.cloudDVR || {};\n                    sku = cloudDVR?.productSKU || '';\n                    if (sku) {\n                        cartProducts[sku] = {\n                            category: categoryCleanUp(\"cdvr\"),\n                            list_price: (cloudDVR?.price || 0) + '',\n                            price: (cloudDVR?.price || 0) + '',\n                            product_id: (cloudDVR?.productId || '') + '',\n                            quantity: (cloudDVR?.quantity || 1) + '',\n                            sku: sku + ''\n                        };\n                    }\n\n                    // Equipments\n                    const equipmentItems = dataSource?.equipment?.devices || [];\n                    if (Array.isArray(equipmentItems)) {\n                        equipmentItems.forEach(item => {\n                            sku = item?.productSKU || '';\n                            const priceValue = item?.price || 0;\n                            let quantity = Number(item?.quantity || 1);\n                            const price = quantity > 1 ? priceValue / quantity : priceValue;\n                            cartProducts[sku] = {\n                                category: categoryCleanUp(\"equipment\"),\n                                list_price: (item?.totalPrice || 0) + '',\n                                price: (price || 0) + '',\n                                product_id: (item?.productId || '') + '',\n                                quantity: quantity + '',\n                                sku: sku + ''\n                            };\n                        });\n                    }\n\n                    // Advance Receiver Fee\n                    const advanceReceiverFee = dataSource?.advancedReceiverFee || null;\n                    sku = advanceReceiverFee?.productSKU || '';\n                    if (sku) {\n                        cartProducts[sku] = {\n                            category: categoryCleanUp(advanceReceiverFee?.name || 'advanced receiver service'),\n                            list_price: (advanceReceiverFee?.totalPrice || 0) + '',\n                            price: (advanceReceiverFee?.price || 0) + '',\n                            product_id: (advanceReceiverFee?.productId || '') + '',\n                            quantity: '1',\n                            sku: sku + ''\n                        };\n                    }\n\n                    // Code to add ars fee in cart if ars fee is present on UI since direct data source for ars is not available on the site.\n                    const directvStreamingAppFlag = Array.from(cartElements).some(item =>\n                        item?.innerText?.toLowerCase().trim().replace(\"ⓘ\", \"\") === 'directv streaming app'\n                    );\n\n                    if (directvStreamingAppFlag) {\n                        cartProducts['directvStreamingApp'] = {\n                            category: categoryCleanUp('directv streaming app'),\n                            list_price: '0',\n                            price: '0',\n                            product_id: 'directvStreamingApp',\n                            quantity: 1,\n                            sku: 'directvStreamingApp'\n                        };\n                    }\n                }\n                else if (productType === \"satellite\") {\n                    dataSource = localStorage.getItem('satellite') ? JSON.parse(localStorage.getItem('satellite')) : {};\n\n                    // Equipments\n                    const equipmentItems = dataSource?.equipment?.devices || [];\n                    if (Array.isArray(equipmentItems)) {\n                        equipmentItems.forEach(item => {\n                            sku = item?.productSKU || '';\n                            cartProducts[sku] = {\n                                category: categoryCleanUp(\"equipment\"),\n                                list_price: (item?.totalPrice || 0) + '',\n                                price: (item?.price || 0) + '',\n                                product_id: (item?.productId || '') + '',\n                                quantity: (item?.quantity || 1) + '',\n                                sku: sku + ''\n                            };\n                        });\n                    }\n\n                    // Code to add ars fee in cart if ars fee is present on UI since direct data source is not available on the site.\n                    const arsFeeFlag = Array.from(cartElements).some(item =>\n                        item?.innerText?.toLowerCase().trim().replace(\"ⓘ\", \"\") === 'adv. receiver fee'\n                    );\n\n                    if (arsFeeFlag) {\n                        cartProducts['ars'] = {\n                            category: categoryCleanUp('ars'),\n                            list_price: '15',\n                            price: '15',\n                            product_id: 'ars',\n                            quantity: 1,\n                            sku: 'ars'\n                        };\n                    }\n\n                    // Code to add professional installation fees in cart if professional installation fee is present on UI since direct data source is not available on the site.\n                    const professionalInstallationFlag = Array.from(cartElements).some(item =>\n                        item?.innerText?.toLowerCase().trim().replace(\"ⓘ\", \"\") === 'professional installation'\n                    );\n\n                    if (professionalInstallationFlag) {\n                        cartProducts['professionalInstallation'] = {\n                            category: categoryCleanUp('professional installation'),\n                            list_price: '0',\n                            price: '0',\n                            product_id: 'professionalInstallation',\n                            quantity: '1',\n                            sku: 'professionalInstallation'\n                        };\n                    }\n                }\n\n                // Base Package \n                const basePackage = dataSource?.package || {};\n                sku = basePackage?.productSKU || '';\n                if (sku) {\n                    cartProducts[sku] = {\n                        category: categoryCleanUp(\"base package\"),\n                        list_price: (basePackage?.basePrice || 0) + '',\n                        price: (basePackage?.price || 0) + '',\n                        product_id: (basePackage?.productId || '') + '',\n                        quantity: '1',\n                        sku: sku + ''\n                    };\n                }\n\n                // Regional Sports Fee\n                const rsnFee = dataSource?.zipDetails?.rsnFee || '';\n                if (rsnFee) {\n                    cartProducts['rsn'] = {\n                        category: categoryCleanUp('rsn'),\n                        list_price: (rsnFee || 0) + '',\n                        price: (rsnFee || 0) + '',\n                        product_id: 'rsn',\n                        quantity: '1',\n                        sku: 'rsn'\n                    };\n                }\n\n                // Add ons\n                const addOns = dataSource?.addOns || [];\n                if (Array.isArray(addOns)) {\n                    addOns.forEach(item => {\n                        sku = item?.productSKU || '';\n                        cartProducts[sku] = {\n                            // category: categoryCleanUp(item?.category === 'Specials' ? \"offer\" : 'addons' || ''),\n                            category: categoryCleanUp(item?.category || ''),\n                            list_price: (item?.price || 0) + '',\n                            price: (item?.price || 0) + '',\n                            product_id: (item?.productId || '') + '',\n                            quantity: (item?.quantity || 1) + '',\n                            sku: sku + ''\n                        };\n                    });\n                }\n                z1log(\"cartProducts AFTER resync : \", cartProducts);\n                localStorage.setItem(cartLocalStorageKey, JSON.stringify(cartProducts));\n            };\n\n            this.clear = () => {\n                this.cartProducts = {};\n                localStorage.setItem(cartLocalStorageKey, JSON.stringify(this.cartProducts));\n            };\n\n            this.init();\n        }\n\n        function User() {\n            let loggedInStatus = 'N';\n            let customerId = '';\n\n            const getCustomerId = () => {\n                try {\n                    const user_id = util.getCookie('BAN') || '';\n                    if (user_id) { customerId = user_id; }\n                    return customerId;\n                } catch (e) {\n                    z1log(\"Error occurred from getCustomerId:\", e);\n                }\n            };\n\n            const getLoggedInStatus = () => {\n                try {\n                    const user_id = util.getCookie('BAN') || '';\n                    if (user_id) { loggedInStatus = 'Y'; }\n                    return loggedInStatus;\n                } catch (e) {\n                    z1log(\"Error occurred from getLoggedInStatus:\", e);\n                }\n            };\n\n            this.init = () => {\n                getLoggedInStatus();\n                if (loggedInStatus === 'Y') { getCustomerId(); }\n            };\n\n            this.info = () => { return { loggedInStatus, customerId }; };\n\n            //run on new instance\n            this.init();\n        }\n\n        // TODO: Create the Path interface\n        function Page(name, path) {\n            this.name = name;\n            this.path = path;\n            t
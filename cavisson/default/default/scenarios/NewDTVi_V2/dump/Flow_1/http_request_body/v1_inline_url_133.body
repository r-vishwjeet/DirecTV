{"query":"query embedChatQuery(\n  $token: String!\n  $release: String\n  $enableContactCenter: Boolean\n  $userIdentityToken: String\n  $loadDemoConfig: Boolean = false\n  $windowId: String\n  $locale: String\n) {\n  embedBotByToken(token: $token, release: $release, fullscreen: false, enableContactCenter: $enableContactCenter, userIdentityToken: $userIdentityToken, windowId: $windowId, locale: $locale) {\n    __typename\n    ...embedChatFragment\n    ... on Node {\n      __isNode: __typename\n      id\n    }\n  }\n}\n\nfragment embedChatFragment on EmbedBotResult {\n  __isEmbedBotResult: __typename\n  ... on EmbedBot {\n    __typename\n    token\n    releaseHash\n    brand {\n      botName\n      chatStyle\n      logoSVG\n      sendButtonSVG\n      sendButtonDisabledSVG\n      greetingMessage\n      agentTransferWaitingMessage\n      agentTransferQueueSizeMessage\n      agentTransferQueueNextMessage\n      agentTransferEstimatedWaitMessage\n      agentTransferAverageWaitMessage\n      showAgentTransferWaitingMessage\n      agentTransferQueueNameMessage\n      agentJoinedMessage\n      agentLeftMessage\n      errorMessage\n      canRenderMessageImages\n      inactivityMessage\n      disclosure\n      inputPlaceholder\n      conversationEndedMessage\n      logoIncludesAgentName\n      dimensions {\n        width\n        height\n        maxHeight\n      }\n      voiceDisclosure\n      voiceStyle {\n        controls {\n          muteButton {\n            label\n            backgroundColor\n            iconSVG\n            iconColor\n          }\n          unmuteButton {\n            label\n            backgroundColor\n            iconSVG\n            iconColor\n          }\n          endCallButton {\n            label\n            backgroundColor\n            iconSVG\n            iconColor\n          }\n        }\n      }\n      textStreamStyle {\n        delayMs\n        fadeIn\n      }\n      showTimestamps\n      showBotName\n      defaultLiveAgentDisplayName\n      showAvatars\n      agentAvatarURL\n      messageLabelPlacement\n      textDirection\n      uiStrings\n      autoUpdateUiStrings\n      agentDisabledMessage\n      surveyPrompt\n      surveyNegativeFeedback\n      surveyNeutralFeedback\n      surveyPositiveFeedback\n    }\n    contactCenterConfig {\n      contactCenterEnabled\n      customerCanSendAfterAgentLeave\n    }\n    issueCategories {\n      id\n      label\n    }\n    embedConfig {\n      attachmentsStyle\n      textConfig {\n        enabledEvents\n        inactivityTimeoutSeconds\n        serverSideInactivityEnabled\n        chatInputCharacterLimit\n        clientStartEventMaxFreezeMs\n        useLegacyClientEventSendBehavior\n        clientEventWaitingSlotEnabled\n      }\n    }\n    webBuildToken\n    webCSSToken\n    studioAttachmentsToken\n    markdownLinksEnabled\n    additionalMarkdownLinkProtocols\n    turnstileSiteKey\n    windowId\n    windowToken\n    serverWindowPropagationEnabled\n    webKeyboardAvoidanceEnabled\n    embedDemoConfig @include(if: $loadDemoConfig) {\n      enabled\n      phoneNumber\n    }\n  }\n  ... on EmbedBotError {\n    __typename\n    message\n    code\n  }\n  ... on EmbedBotDisabled {\n    __typename\n    agentDisabledMessage\n  }\n}\n","variables":{"token":"4QpFj40BkclJ60wBkcnYOoWQDHuAyiA1DPD6MLm-wkY","release":"Staging","windowId":"ca992ae6-1d9c-4398-988e-6491bc23d6ae"},"extensions":{"windowId":"ca992ae6-1d9c-4398-988e-6491bc23d6ae"}}
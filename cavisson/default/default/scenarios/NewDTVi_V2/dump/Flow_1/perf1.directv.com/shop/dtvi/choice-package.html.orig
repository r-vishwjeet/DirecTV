Roku\u003c/b\u003e -  Roku Streaming Stick® \u0026 Streaming Stick+; Roku Express \u0026 Express+; Roku Premiere \u0026 Premiere+; Roku Ultra \u0026 Roku LT; Roku 1 SE; Roku 2-4; 4k \u0026 Non-4K Roku TV; Roku Smart Soundbar","\u003cb\u003eHeads up:\u003c/b\u003e Amazon Kindle Fire HD \u0026 HDX are no longer supported on the DIRECTV App. Sign into the DIRECTV App with your user ID and password. Wi-Fi access is recommended. Data charges may apply."]},"strikePrice":false,"productImage":"/dtvassets/sales/pcp/imagery/gemini-air-checkout-modal.svg","isSpecialOffer":false,"isWirelessServer":false,"productSKUs":["OF_REFURB-GEMINILEASE-202604_RR","OF_HARD-GEMINILEASE-202311_RR"],"isEligibleCustomer":false,"productImageFusion":"/dtvassets/sales/pcp/imagery/gemini-air-checkout-modal.svg","directvAppDescription":{"_uid":"c1f67210-385e-46ba-a4a6-1850cb233726","tableTitle":"See how they stack up","table":[{"id":"pcplearnMoreModal","_uid":"5659d0a0-c5d4-4d32-818c-337f05832ab8","type":"LEARNMOREMODAL","rows":[{"_uid":"b38a18cb-4cb9-4f7e-9d2a-05cc940ff7b8","cells":[{"_uid":"3415afbb-4dc2-464f-ac6c-961c666529c8","text":"Thousands of on-demand titles","tooltip":"Play, stop, rewind your favorite shows and movies through our programming library.","contentType":"textAndTootip"},{"_uid":"d922c3d5-a01b-4782-8ce4-212279485cb7","contentType":"check"},{"_uid":"1dab349f-c4ec-4a2a-a0ac-ae664cf9ee23","contentType":"check"}]},{"_uid":"fe28e2d2-b1fb-4c48-bd5f-a970a3e0e975","cells":[{"_uid":"42ac32d7-1160-42ee-81ed-2f4b35deddf1","text":"Access to live and local TV channels","cellTextClass":"text"},{"_uid":"233ea818-5c92-46f4-9015-127f8b2ea647","contentType":"check"},{"_uid":"53b90171-a6f7-4a08-abaa-fee5cdb920f0","contentType":"check"}]},{"_uid":"d501de8c-9e94-48b4-81bf-9e86db62925d","cells":[{"_uid":"64c15392-6c1f-40d8-87b5-7f53a0443d6c","text":"Unlimited recording hours","contentType":"text"},{"_uid":"5d97df3d-66ec-4923-ae10-3cb95136860b","contentType":"check"},{"_uid":"2fbccebe-24c9-4d9c-b3f7-d
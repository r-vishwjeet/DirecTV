al/icons/2022/svod-icon_email_how-to-watch-modal.svg","subHeader":"Activate your subscription","imageClass":"imgHeight","imageSubClass":"fontBody2","imageSubContent":"You can start watching Peacock by accessing the activation link that will be sent via email. You can also activate your subscription by accessing the activation link under your DIRECTV account management."},{"alt":"Download Peacock App","_uid":"3b2843be-e37b-4161-a783-be8f26a004fb","imageUrl":"/dtvassets/global/icons/fusion/fusion_cloud_download_blue600.svg","subHeader":"Download the Peacock app ","imageClass":"imgHeight","imageSubClass":"fontBody2","imageSubContent":"Add the Peacock app to your favorite streaming device, smart TV or mobile device."},{"alt":"Stream Online","_uid":"42b4c2b6-e536-4481-8475-e9161098b241","imageUrl":"/dtvassets/sales/pcp/icons/StreamIcon.svg","subHeader":"Stream online","imageClass":"imgHeight","imageSubClass":"fontBody2","imageSubContent":"You can stream on your PC at \u003ca href='http://peacocktv.com' target='_blank'\u003epeacocktv.com\u003c/a\u003e"}]},"element":"FAQLink","analytics":{"url":"/shop/dtvi/modal-peacock","_uid":"cc91f349-8c04-4d76-aed6-e1c28fa33c2f"},"isWrapper":false}]},"imageUrl":"/assets/content/b7jxoppxfh/svg/Channel-Icon-Peacock-MEP-100x100.svg","isHidden":false,"imageUrl2":"/assets/content/b7jxoppxfh/svg/Channel-Icon-Peacock-MEP-100x100.svg","linkTitle":"See what you get","ariaAtomic":false,"closeTitle":"What you get","productSKU":"OF_MVPXPEACOCK2MFREE_RR","description":"\u003cp\u003eBy clicking Add, you agree that after 2 months, Movies Extra Pack + Peacock Premium auto-renews monthly at then-curr. rate. (curr. $[[basePrice]]/mo. via DIRECTV vs. $10.99/mo. Peacock Premium retail value). Cancel service anytime by managing your DIRECTV subscription. Offer cannot be combined with other offers. Movies Extra Pack may only be accessed on DIRECTV devices, directv.com, and the DIRECTV app.\u003c/p\u003e \u003cp\u003eBy subscribing, you agree to \u003ca href='https://www.peacocktv.com/terms' target='_blank' \u003ePeacock Premium Terms of Service\u003c/a\u003e and \u003ca href='https://www.peacocktv.com/privacy' target='_blank' \u003ePrivacy Policy\u003c/a\u003e.\u003c/p\u003e \u003cp\u003eAfter you complete your purchase, we’ll send you an email to activate your Peacock Premium subscription online. This will not cancel any other Peacock subscriptions you have. Manage any existing Peacock subscription on peacocktv.com before activating. Subject to discontinuation, change, or cancellation at any time. U.S. only.\u003c/p\u003e \u003cp\u003eWatch Peacock Premium on the Peacock app or peacocktv.com.\u003c/p\u003e","strikePrice":false,"regPriceText":"then [[regPrice]]/mo.","isOfferRibbon":false,"isSpecialOffer":true,"promoPriceText":"2 months included","isEligibleCustomer":false,"seeWhatYouGetContent":{"_uid":"fd68d120-3cff-404d-a397-89d610109b31","heading":"Movies Extra Pack + Peacock Premium has 9 entertainment channels:","listItems":[{"_uid":"7805191f-c00f-4a15-8bd2-5b2dbac9ff72","listContent":"Crime + Investigation"},{"_uid":"134427e9-4d55-434b-9c41-5d79c1ba0ba8","listContent":"Hallmark Family"},{"_uid":"b05dd2f9-333c-4eef-811b-53a69170a3c9","listContent":"Hallmark Mystery"},{"_uid":"a67da6af-f61a-4f9c-ac10-2ae999c8d901","listContent":"HDNET MOVIES"},{"_uid":"4832048d-8fd3-4641-b7f7-4c43300103e1","listContent":"INSP HD"},{"_uid":"36861d1f-80f5-430c-b35f-6b4a9003b51e","listContent":"MTV Live"},{"_uid":"5ab25eaa-965b-4fb0-9e26-ba52a2708b9e","listContent":"Smithsonian Channel"},{"_uid":"3f5cc3c5-634f-4638-abaf-dd5470ee10a7","listContent":"ShortsTV"},{"_uid":"63bebe60-9d52-4bc1-8698-a1668a3f52c6","listContent":"Sony Movies"}],"moreItems":[{"_uid":"edb95054-4a0c-4eef-92dc-a742cb2615f8","content":"With Peacock Premium, stream blockbuster movies, your favorite TV shows, exclusive Originals, and sports.","isWrapper":false}]},"hideTooltipOnCartSummary":false,"svgMarkup":"\u003csvg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=
assName":"ctaAddDeviceStyle","prop_fullWidth":true,"prop_startIcon":false,"prop_useNextLink":false},"prop_fullWidth":false,"prop_startIcon":false,"wncbreContinue":{"_uid":"7dab52e9-6a74-4323-b338-9a103e1d56ba","content":"Secure Checkout","element":"Button","isWrapper":false,"prop_href":"[[productUrl]]","prop_size":"large","prop_type":"submit","prop_color":"primary","prop_href_as":"/checkout","prop_variant":"contained","prop_ariaLabel":"Secure Checkout","prop_className":"ctaAddDeviceStyle","prop_fullWidth":true,"prop_startIcon":false,"prop_useNextLink":false},"prop_useNextLink":false,"freeTrialContinueCTA":{"_uid":"687b770e-ac19-42e4-bc48-c373c6214e01","content":"Start [[freeTrialDuration]]-day free trial","element":"Button","tabIndex":"[tabIndex]]","isWrapper":false,"prop_href":"[[productUrl]]","prop_size":"large","prop_type":"submit","prop_color":"primary","prop_href_as":"/checkout","prop_variant":"contained","prop_ariaLabel":"start free trial button","prop_className":"ctaDtviToCheckout","prop_fullWidth":true,"prop_startIcon":false,"prop_useNextLink":false},"pcpContinueToCheckout":{"_uid":"fa077d63-e5b9-4909-98c7-c08bd9c1be23","content":"Secure checkout","element":"Button","isWrapper":false,"prop_size":"large","prop_type":"submit","prop_color":"primary","prop_href_as":"/checkout","prop_variant":"contained","prop_ariaLabel":"Secure Checkout Button","prop_className":"ctaDtviToCheckout","prop_fullWidth":false,"prop_startIcon":false,"prop_useNextLink":false},"splitPcpContinueDevices":{"_uid":"5cb8039b-8f5f-4271-aa53-f68df16e30c3","content":"Continue","element":"Button","isWrapper":false,"prop_size":"large","prop_type":"submit","prop_color":"primary","prop_variant":"contained","prop_ariaLabel":"Continue","prop_className":"splitPcpContinueDevices","prop_fullWidth":true,"prop_startIcon":false,"prop_useNextLink":false}},"faqLinks":{"_uid":"5a11bbc5-6446-45d5-a2e7-5d1c6cf894b8","cloud":[{"img":"/dtvassets/sales/pcp/modal/cloud_DVR.png","_uid":"ef19e717-8c28-4587-9313-19d12f5be80f","legal":"\u003csup\u003e1\u003c/sup\u003eData connection req’d. Recordings expire after 90 days. In a series recording, max 30 episodes stored with unlimited hours of cloud DVR and max 10 episodes stored with 20 hours of cloud DVR (oldest deleted first which may be in less than 90 days). Restrictions apply.\u003cbr /\u003e\u003csup\u003e2\u003c/sup\u003eLimited to 3 concurrent out-of-home streams. Available only in the U.S. (excl. Puerto Rico \u0026amp; U.S.V.I.). Req’s compatible device \u0026amp; data connection.","modal":"cloudDvr","title":"WITH CLOUD DVR, NEVER MISS YOUR FAVORITES","caption":"What do I get with Cloud DVR?","content":"\u003cul\u003e\u003cli\u003eRecord 20 hours of your favorite movies, shows, and more, or make it unlimited hours for $10/mo. + tax. \u003c/li\u003e\u003cli\u003eUnlimited simultaneous recordings means no more conflicts.\u003csup\u003e1\u003c/sup\u003e\u003c/li\u003e\u003cli\u003eYour DVR recordings go where you go.\u003csup\u003e2\u003c/sup\u003e\u003c/li\u003e\u003c/ul\u003e","element":"FAQLink","analytics":{"url":"/shop/dtvi/modal-cloud-dvr-features","_uid":"0bb67541-0d1c-432d-b110-0b72394efdf9"},"isWrapper":false},{"_uid":"ec8b0ddd-bfb0-46b2-be5d-51d63b0f6809","modal":"CloudHelper","title":"Get the space you need","caption":"How much storage do I need?","content":{"_uid":"57525807-6d30-4c47-b340-4a3d12380193","legal":"Data connection req’d. Recordings expire after 90 days. In a series recording, max 30 episodes stored with unlimited hours of cloud DVR and max 10 episodes stored with 20 hours of cloud DVR (oldest deleted first which may be in less than 90 days). Restrictions apply.","twentyHr":"\u003cstrong\u003eRecord a little\u003c/strong\u003e\u003cul\u003e\u003cli\u003eThis week's game\u003c/li\u003e\u003cli\u003eOne season of your favorite show\u003c/li\u003e\u003cli\u003eThe movie that’s not on demand\u003c/li\u003e\u003c/ul\u003e","fiveHndrdHr":"\u003cstrong\u003eDon’t miss a thing—record it all!\u003c/strong\u003e\u003cul\u003e\u003cli\u003eAll your entertainment is ready when you are\u003c/li\u003e\u003cli\u003eBuild a binge-worthy library with unlimited storage space\u003c/li\u003e\u003cli\u003eDiscover new favorites\u003c/li\u003e\u003cli\u003eUnlimited movies and single episodes\u003c/li\u003e\u003c/ul\u003e"},"element":"FAQLink","subtitle":"Record a little or a lot—you’ll never miss out on great entertainment","analytics":{"url":"/shop/dtvi/modal-how-much-storage","_uid":"626efe21-c676-4dad-9e28-2be6d21f9aa3"},"isWrapper":false}],"promo":[{"_uid":"db11dce3-a080-43f3-9b2d-8e1ec62d424b","title":"Here’s how to watch HBO Max™ with DIRECTV STREAM","caption":"How do I watch HBO Max Standard?","content":{"_uid":"219c22a2-23b2-4261-bda4-f06b8df7460c","images":[{"alt":"DIRECTV STREAM app","_uid":"08ecbc1a-4e80-444e-9b86-3cf562be115d","imageUrl":"https://www.directv.com/dtvassets/sales/directv/lower_funnel/pcp/stream/DTV_app_icon.png","imageHeader":"DIRECTV STREAM app","imageSubContent":"Watch HBO® channels and HBO On Demand with DIRECTV STREAM app, and find your HBO® entertainment within the channel guide."},{"alt":"HBO Max App","_uid":"f334fa25-5e66-4751-b3b2-21d8fe1f4642","imageUrl":"https://www.directv.com/dtvassets/sales/atttv/assets/HBO%20Max%20App.png","imageHeader":"HBO Max App","imageSubContent":"Stream at hbomax.com or download the HBO Max app, choose your provider (DIRECTV), then sign in with your DIRECTV user ID and password."}],"learnMoreConditions":"Compatible device and online account registration required for HBO Max access. Data rates may apply for app download/usage."},"subtitle":"HBO Max Standard includes all of HBO together with the greatest collection of movies, shows, and new HBO Max Standard originals.","analytics":{"url":"/shop/dtvi/modal-hbo-max","_uid":"56820059-0073-452e-a5b5-a620ddde5fd8"},"isWrapper":false}],"componentKey":"faqLinks","checkout":[{"_uid":"d8259c20-dce4-489e-84da-95334d591d7c","legal":"\u003cdiv\u003e\u003cp\u003eYour DIRECTV STREAM service will renew monthly at the rates listed above(or at the then-prevailing rate),plus taxes and fees,unless it's canceled. Prices are subject to change at any time. To change or cancel service, call 800.288.2020 or got to att.com to manage your account or chat with an agent.\u003c/p\u003e\u003cp\u003eYou will not receive a monthly bill. You can view your account information and payment activity by going to att.com/myatt.\u003c/p\u003e\u003c/div\u003e","modal":"StandardHelper","title":"DIRECTV STREAM Schedule of Future Payments","caption":"See DIRECTV STREAM schedule of future payments","content":"\u003cdiv\u003e\u003cp\u003ewe will charging you on a monthly basis when you activate service on your TV, or on February 12,2021, whichever comes first.\u003c/p\u003e\u003ch4\u003eMonthly auto-charges\u003c/h4\u003e\u003ctable\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd\u003eMonths 1-12\u003c/td\u003e\u003ctd\u003e$82.14\u003c/td\u003e\u003c/tr\u003e \u003ctr\u003e\u003ctd\u003eMonths 13+ \u003c/td\u003e\u003ctd\u003e$117.13\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e","element":"FAQLink","isWrapper":false}],"equipment":[{"_uid":"8c21dfca-ed07-49b9-8313-f023ef162824","modal":"DeviceHelper","title":"Watch DIRECTV STREAM with Apple TV, Amazon Fire TV stick, Roku®, and more.*","caption":"What devices are compatible with DIRECTV STREAM?","content":{"_uid":"2a3ad461-c193-45ae-b2b7-41930114ccfb","legalText":"*HBO Max compatibility may differ. Please go to hbomax.com for details.","images":[{"_uid":"2847929c-2647-47bf-9e46-069413342284","desc":"\u003cp\u003eGet all your favorite apps in one place, use our voice remote to find and control your entertainment, and enjoy easy self-setup.\u003c/p\u003e","title":"DIRECTV STREAM","header":"\u003cp\u003eDIRECTV STREAM Device\u003c/p\u003e","imageUrl":"/dtvassets/sales/directv/lower_funnel/pcp/stream/DTV_stream_PCP_112.svg"},{"_uid":"cbf71e4a-9d2e-4874-88e2-8751a5a9a96e","desc":"\u003cp\u003eAmazon Fi
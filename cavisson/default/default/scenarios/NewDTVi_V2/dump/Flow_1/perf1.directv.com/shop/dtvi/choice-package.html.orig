rket due to blackout rules and other conditions."},"hideTooltipOnCartSummary":false},{"_uid":"a567083f-4a9b-46ca-ae2c-fe0fdc8c2ead","name":"Disney+","altText":"Disney Plus","ribbons":{"_uid":"6b0657e8-deb9-4726-858f-a570ec39abe3","dollarIconUrl":"https://www.directv.com/assets/content/id8e97z4bd/svg/fusion-offers-icon-green700.svg","dealRibbonText":"INCREDIBLE DEAL!","showDealRibbon":false,"recommendedRibbonText":"RECOMMENDED","showRecommendedRibbon":false},"features":[{"_uid":"4cad0a51-fc38-46ea-93bc-9cc9a1ac5183","icon":"/assets/content/ejjxj7jk2o/svg/fusion-multiview-icon-blue900.svg","content":"Includes ads"},{"_uid":"99f9c272-a354-4bb2-9ebc-45177e0990e5","icon":"/assets/content/fgd69udftl/svg/fusion_new-icon_filled_blue900.svg","content":"New releases \u0026 classics"},{"_uid":"1510f825-1661-4865-a677-c2ce6b6d4765","icon":"/assets/content/oaolborgdc/svg/fusion_featured-entertain-icon_filled_blue900.svg","content":"Exclusive originals"},{"_uid":"f4b5a4df-5936-4a99-90f5-72e1ecdc1912","icon":"/assets/content/m0yzug02na/svg/fusion_watch-on-tv_blue900.svg","content":"Multiple streams"}],"imageUrl":{},"isHidden":false,"imageUrl1":{},"imageUrl2":{},"linkTitle":"See what you get","ariaAtomic":false,"closeTitle":"What you get","productSKU":"OF_BOLT-DISNEYBASICALC-202604_RR","description":"Account activation required. You will receive separate information via email on how to activate your account. Streaming only available via the Disney+ app or disneyplus.com. If you already have a Disney bundle, Disney+, Hulu, or ESPN subscription, it may be necessary to manage your plan to avoid multiple subscriptions. It is your responsibility to manage your subscriptions. © 2026 Disney and its related entities.","featureName":"With Ads","strikePrice":false,"imageUrlIncl":{},"isGroupOffer":false,"isOfferRibbon":false,"modalImageUrl":{},"isSpecialOffer":false,"checkMarkIconUrl":{},"groupDisplayName":"Disney+","offerModalLogoUrl":{},"isEligibleCustomer":false,"trialLanguageLabel":"Disne
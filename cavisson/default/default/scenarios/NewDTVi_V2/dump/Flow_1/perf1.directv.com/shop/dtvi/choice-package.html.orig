erification.","contentType":"textAndTootip"},{"_uid":"5c5cdc41-db89-4342-90bc-d500a9923e89","text":"Incl. with service","contentType":"text"}],"cust_isLegalModal":false}],"outerBorder":false,"stickyColumn":false,"stickyHeader":false,"equalColWidth":false,"verticalLines":false,"horizontalLines":false,"rowColorPattern":false,"enableTextUpdate":false}],"imagesGemini":[{"alt":"Gemini device and remote in front of a TV","_uid":"cdc6c960-422c-4a44-b8e5-4a35b79b8a84","flag":false,"imageUrl":"/assets/content/hi9jzduzwn/web/GeminiMod653734.png","imageClass":"imageSize","imageContent":"Get live TV, local channels and your favorite apps.","imageSubClass":"h3","imageContClass":"h3","imageSubContent":"Switch between live, recorded, and On Demand TV—or to apps like Max™, Netflix, or Prime Video—without missing a beat.*","subscriptionContent":"*Subscriptions required for 3\u003csup\u003erd\u003c/sup\u003e party providers. Disney+ and Hulu included with streaming device."},{"alt":"Person sitting on couch watching TV","_uid":"b4e5a5c4-bc2b-4931-83fb-562753090fac","flag":false,"imageUrl":"/dtvassets/sales/pcp/imagery/gemini-learn-more-livingroom-tv-mockup-larger-tv.jpg","imageUrl1":"https://www.directv.com/assets/content/ooadndhhbl/","imageClass":"imageSize","imageContent":"Universal voice remote powered by Google","imageSubClass":"fontBody2","imageContClass":"fontBody1","imageSubContent":"It’s a snap to use. Easily pair with most TVs and sound systems. Control live TV, apps, smart home devices*, and more with a single remote control.","imageContentLeft":"It’s a snap to use.","imageContentRight":"Voice commands control your TV and more","imageSubContentLeft":"Easily pair with most TVs and sound systems. Control live TV, apps, smart home devices*, and more with a single remote control.","subscriptionContent":"*Certain commands will depend on 3\u003csup\u003erd\u003c/sup\u003e party functionalities.","imageSubContentRight":"'Is it going to rain today?'\u003cbr\u003e'Launch Netflix'\u003cbr\u003e'Play some music'\u003cbr\u003e'Dim the lights'"},{"alt":"Gemini device measurements","_uid":"1467aaa2-199a-4ad7-aa1d-478f49b70753","flag":false,"imageUrl":"/assets/content/m2gzeorvd1/web/GeminiMod423982.png","imageContent":"Easy setup with a compact design","imageSubContent":"The latest Gemini device is a compact 5.9” x 3.15”, fitting easily on your TV console or even mounted behind your TV using the device’s built-in fastener slot.*","subscriptionContent":"*Connects to a standard HDMI port. Power cord not shown."},{"alt":"TV displaying DIRECTV Streaming App","_uid":"44ca4e13-10b0-47d4-b258-674f3277b7e3","flag":false,"tooltip":"Req’s separate subscription for 3rd party apps. Restrictions apply. High speed internet connection req’d.","imageUrl":"/dtvassets/sales/pcp/imagery/gemini-learn-more-tv-image-directv-apps.jpg","imageContent":"Access to your favorite shows and apps","imageSubContent":"Watch live TV and enjoy thousands of streaming apps at your fingertips like MaxTM, Netflix, or Prime Video and more on Google Play* from inside the DIRECTV experience.","subscriptionContent":"\\\"*Google login required. Google is a trademark of Google LLC."},{"alt":"TV with image of an astronaut looking at a planet","_uid":"f69da3be-9662-4233-a5b2-a3735b3e1a46","flag":false,"tooltip":"Picture quality dependent on programming and TV compatibility.","imageUrl":"/dtvassets/sales/pcp/imagery/gemini-learn-more-4k-tv-space.jpg","imageContent":"Streaming in high-quality video","imageSubContent":"Get incredible 4k HD programming."},{"alt":"Living room TV and Dolby Atmos logo","_uid":"8fa51c43-133b-4106-b2e3-90fc3fb05f1d","flag":false,"imageUrl":"/dtvassets/sales/pcp/imagery/gemini-learn-more-dolby-atmos.jpg","imageContent":"Surround sound for an amazing home theater experience","imageSubContent":"Dolby Atmos 5.1 enabled. Requires compatible audio receiver and speakers.\u003ca href='https://www.dolby.com/' target='_blank'\u003e Learn more at Dolby \u003c/a\u003e"},{"_uid":"57c8
,"verticalLines":false,"horizontalLines":false,"rowColorPattern":false,"enableTextUpdate":false}],"imagesGemini":[{"alt":"Gemini device and remote in front of a TV","_uid":"e19e3f2e-3f22-411a-987c-8ed828c95117","imageUrl":"/dtvassets/sales/pcp/imagery/gemini-learn-more-air-tv.jpg","imageClass":"imageSize","imageContent":"Get live TV, local channels and your favorite apps.","imageSubClass":"h3","imageContClass":"h3","imageSubContent":"Switch between live, recorded, and On Demand TV—or to apps like Max™, Netflix, or Prime Video—without missing a beat.*","subscriptionContent":"*Subscriptions required for 3\u003csup\u003erd\u003c/sup\u003e party providers. Disney+ and Hulu included with streaming device."},{"alt":"Person sitting on couch watching TV","_uid":"c63c7581-a52e-42fa-b283-5e9524dbcf2a","imageUrl":"/dtvassets/sales/pcp/imagery/gemini-learn-more-livingroom-tv-mockup-larger-tv.jpg","imageUrl1":"https://www.directv.com/assets/content/ooadndhhbl/","imageClass":"imageSize","imageContent":"Universal voice remote powered by Google","imageSubClass":"fontBody2","imageContClass":"fontBody1","imageSubContent":"It’s a snap to use. Easily pair with most TVs and sound systems. Control live TV, apps, smart home devices*, and more with a single remote control.","imageContentLeft":"It’s a snap to use.","imageContentRight":"Voice commands control your TV and more","imageSubContentLeft":"Easily pairs with most TVs and sound systems. Control live TV, apps, smart home devices*, and more with a single remote control.","subscriptionContent":"*Certain commands will depend on 3\u003csup\u003erd\u003c/sup\u003e party functionalities.","imageSubContentRight":"\"Is it going to rain today?\"\u003cbr/\u003e\"Launch Netflix\"\u003cbr/\u003e\"Play some music\"\u003cbr/\u003e\"Dim the lights\""},{"alt":"Gemini device displaying HDMI cable and measurements 1.9” x 3.7","_uid":"bb794cfe-0c90-44e3-a705-9a5a5dcf8d60","imageUrl":"/dtvassets/sales/pcp/imagery/gemini-learn-more-air-dimensions.jpg","imageContent":"Easy setup with a compact design","imageSubContent":"The latest Gemini Air device is an amazingly small 1.9” x 3.7”, fitting behind almost any TV. Enjoy easy self-setup in minutes—just sign up, plug into a power source, and make a single connection to your TV.*","subscriptionContent":"*Connects to a standard HDMI port. Power cord not shown."},{"alt":"TV displaying DIRECTV Streaming App","_uid":"684e0c0d-d85e-4284-ba98-71290fbce8e4","tooltip":"Req’s separate subscription for 3rd party apps. Restrictions apply. High speed internet connection req’d.","imageUrl":"/dtvassets/sales/pcp/imagery/gemini-learn-more-tv-image-directv-apps.jpg","imageContent":"Access to your favorite shows and apps","imageSubContent":"Watch live TV and enjoy thousands of streaming apps at your fingertips like MaxTM, Netflix, or Prime Video and more on Google Play* from inside the DIRECTV experience.","subscriptionContent":"*Google login required. Google is a trademark of Google LLC."},{"alt":"TV with image of an astronaut looking at a planet","_uid":"8eec7949-d3c0-47c2-8506-35783d00ff3b","flag":false,"tooltip":"Picture quality dependent on programming and TV compatibility.","imageUrl":"/dtvassets/sales/pcp/imagery/gemini-learn-more-4k-tv-space.jpg","imageContent":"Streaming in high-quality video","imageSubContent":"Get incredible 4k HD programming."},{"alt":"Living room TV and Dolby Atmos logo","_uid":"b640d155-f34e-4892-abf1-de342d64b067","flag":false,"imageUrl":"/dtvassets/sales/pcp/imagery/gemini-learn-more-dolby-atmos.jpg","imageContent":"Surround sound for an amazing home theater experience","imageSubContent":"Dolby Atmos 5.1 enabled. Requires compatible audio receiver and speakers.\u003ca href='https://www.dolby.com/' target='_blank'\u003e Learn more at Dolby \u003c/a\u003e"},{"_uid":"046c5868-5a77-4aef-98b2-227d121321d7","flag":false,"imageClass":"imageSize","compareTable":{"id":"pcplearnMoreModal","_uid":"22c5d0ee-927f-43f7-8340-bfe52869b255","type":"LEARNMOREMODAL","head1":
:"88e2abbf-ec74-4686-8467-a6a55283f963","contentType":"check"},{"_uid":"9249321d-638b-4cc6-8bb7-0fc788f4c657","text":"Dependent on device","tooltip":"DIRECTV is available on Smart TV’s and other electronic devices. High-speed internet connection req’d with 3rd party streaming devices.","contentType":"textAndTootip"}]}],"outerBorder":false,"stickyColumn":false,"stickyHeader":false,"equalColWidth":false,"verticalLines":false,"horizontalLines":false,"rowColorPattern":false,"enableTextUpdate":false},"imageContent":"How does the Gemini Air compare to other streaming devices?","imageSubClass":"h3","imageContClass":"h3","imageSubContent":"With the Gemini Air, you can receive the latest TV experience through our device. Check out how much better your TV experience can be:"},{"alt":"Phone, tablet, and TV with DIRECTV App menu","_uid":"a21164c2-7af6-4818-af23-15b136df7e06","flag":false,"imageUrl":"/dtvassets/sales/pcp/imagery/gemini-learn-more-directv-mobile-tablet-desktop-app-icon.jpg","imageContent":"Watch on the go with DIRECTV App","imageSubContent":"Watch live or recorded shows on your smart TV or favorite mobile device."}],"moreFeatures":[{"alt":"Watch in 4K Ultra HD","_uid":"64cea8c4-9435-43d6-b9a9-97191f5bdd8b","imageUrl":"/dtvassets/global/icons/2022/4k-watch-ultra-hd-icon-64x64.svg","imageContent":"Watch in 4K Ultra HD","imageSubContent":"Get incredible 4K HD Programing.","subscriptionContent":"Picture quality dependent on programming and TV compatibility."},{"alt":"Easy self set-up in minutes","_uid":"60207126-bae4-4030-b89a-aba4d55ec7b1","imageUrl":"/dtvassets/global/icons/2022/easy-setup-icon-64x64.svg","imageContent":"Easy self set-up in minutes","imageSubContent":"Sign up, plug into a power source, and make a single connection to your TV. That’s it!"},{"alt":"Bluetooth connectivity","_uid":"ab6a53ae-5e2f-4059-ad5d-2b785bb4cb0e","imageUrl":"/dtvassets/global/icons/2022/headphone-bluetooth-icon-64x64.svg","imageContent":"Bluetooth connectivity","imageSubContent":
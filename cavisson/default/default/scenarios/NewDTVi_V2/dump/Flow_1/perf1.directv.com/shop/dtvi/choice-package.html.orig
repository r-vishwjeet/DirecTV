-289daba7f22f","text":"Supports 4K video and Dolby Atmos 5.1","tooltip":"The Gemini Device supports 4k viewing and Dolby Atmos 5.1 surround sound, so you can enjoy your watching experience as if you were in a cinema.","contentType":"textAndTootip"},{"_uid":"de0f6f6c-a689-4bd2-8d79-feb746329503","contentType":"check"},{"_uid":"cbc05624-9eb1-4357-9df3-b7fdb05e3a18","text":"Dependent on device","tooltip":"DIRECTV service is compatible with a wide range of devices. Hardware and device capabilities for non-DIRECTV devices vary by manufacturer.","contentType":"textAndTootip"}]},{"_uid":"7a8f223d-46ca-4454-a2ca-53fa97f0d9dc","cells":[{"_uid":"4e2fc499-4d2e-441b-8464-f665930df2bf","text":"Smart home connectivity with Google Assistant","tooltip":"Use Google Assistant on the Gemini Device to control supported smart home devices","contentType":"textAndTootip"},{"_uid":"f83f4b97-afd1-4dc9-b528-7b98bb93c563","contentType":"check"},{"_uid":"a58411b2-3b1a-460a-aa2d-951f1aa90f84","text":"Dependent on device","tooltip":"DIRECTV service is compatible with a wide range of devices. Hardware and device capabilities for non-DIRECTV devices vary by manufacturer.","contentType":"textAndTootip"}]},{"_uid":"0dc5c54d-0f10-47a1-bcd2-980ad530746b","cells":[{"_uid":"93b1c833-233b-4981-a6e7-38c0dce843da","text":"Device dimensions","contentType":"text"},{"_uid":"d3774430-817e-4794-b0f2-521a54d1762b","text":"1.8-inch H 2.25-inch W 6.25-inch D","contentType":"dimension"},{"_uid":"0cdf7e74-25d9-44d8-82a3-41485cf40773","contentType":"empty"}]}],"outerBorder":false,"stickyColumn":false,"stickyHeader":false,"equalColWidth":false,"verticalLines":false,"horizontalLines":false,"rowColorPattern":false,"enableTextUpdate":false}],"centerImage":"/dtvassets/sales/pcp/modal/D_DIRECTV_Device_blank.png","checkimgUrl":"/dtvassets/global/icons/2022/fusion-checkmark-green500-fusion.svg","minusimgUrl":"/dtvassets/global/icons/2022/fusion-hyphen-neutral600-subtract.svg","images":[{"alt":"Gemini Device","_uid":"dd4ba0a8
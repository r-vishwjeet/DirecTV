ent":"Stream on up to 3 devices at once when away from home."},{"alt":"Connect with more devices","_uid":"ea7aba19-6e4e-46f5-80b0-8b26ef1e1811","imageUrl":"/dtvassets/sales/pcp/imagery/DIRECTVapp-compatible-devices-logo-modal.svg","imageContent":"Connect with more devices","imageSubContent":"Download the DIRECTV App to your favorite device, such as a Smart TV, Roku, Amazon Fire Stick, Google Chromecast, Apple TV, smartphone, or tablet."}],"footerContentSub":"\u003csup\u003e2\u003c/sup\u003e Limited to 3 concurrent DIRECTV Streams.","geminiModalTitle":"DIRECTV STREAMING DEVICE","dtvStreamRequired":"Is the Gemini Air Device required?","compareTable":[{"id":"pcplearnMoreModal","_uid":"f3d00314-8333-4c98-9432-e3b7f42a4064","type":"LEARNMOREMODAL","head1":"DIRECTV\u003cbr/\u003e\u003csmall\u003ewith\u003c/small\u003e\u003cbr/\u003e\u003cimg width='72px' src='https://directv.com/dtvassets/sales/pcp/logos/gemini-air-logo-modal.svg'\u003e","head2":"DIRECTV\u003cbr/\u003e\u003cb\u003eApp\u003c/b\u003e","caption":"Compare ways to watch","rows":[{"_uid":"88fb5a42-f618-4ee5-9fa0-2cf913f303d3","cells":[{"_uid":"c6e01121-28f3-452b-a392-cd31e3d672f7","text":"Access to live \u0026 local TV channels","contentType":"text"},{"_uid":"b8827b31-4416-4348-9156-474574bd4612","contentType":"check"},{"_uid":"65479fd0-b4cb-47ba-85e3-af95f4e0a94a","contentType":"check"}]},{"_uid":"4453ce46-0dd5-4712-b0ce-33b54e8dad1e","cells":[{"_uid":"d691dfbc-1bd6-44fd-9288-dbffb754b41a","text":"Unlimited cDVR recording hours","contentType":"text"},{"_uid":"d77fe6e0-67fd-4535-8210-f5c08845e6c8","contentType":"check"},{"_uid":"d9784291-6a7b-4d97-a7dc-53db5cb158d6","contentType":"check"}]},{"_uid":"e6424176-8258-478a-9ef2-3b2d711c9d10","cells":[{"_uid":"f24fb0d0-61bb-4f5f-96ca-6e75928aa08c","text":"Thousands of on-demand titles","tooltip":"Easily find, rent, or view free shows, movies, DIRECTV specials, and other titles whenever you want to watch.","contentType":"textAndTootip"},{"_uid":"834e5888-9238-473d-bafe-3f034e192d25","contentType":"check"},{"_uid":"33de69cf-8631-44fe-bb76-701c350a8842","contentType":"check"}]},{"_uid":"38f4257a-1977-4e8b-9f27-3a5db53983bd","cells":[{"_uid":"566c1155-8fd5-4ca3-9ae0-9d49dba97a30","text":"Voice enabled remote","tooltip":"Control live TV, apps, smart home devices, and more with a single remote control.","contentType":"textAndTootip"},{"_uid":"41de00c6-e831-4bd7-b9a4-de740b61c31a","contentType":"check"},{"_uid":"8c4b35e4-2762-49b0-ae53-74c759650d86","contentType":"empty"}]},{"_uid":"cf58fd8d-c29e-4b8d-98b2-1e5d0c8479a5","cells":[{"_uid":"0a86c6c1-74bb-4df1-96e1-7fd17660eed6","text":"Control TV shows and apps with a single menu","contentType":"text"},{"_uid":"8bd15ff7-c968-4fc8-8903-d2d447eec61a","contentType":"check"},{"_uid":"da21b111-4dc0-4373-aff7-4e19127b0bdc","contentType":"empty"}]},{"_uid":"2dcdd495-003e-419e-9df4-e7877aa40e93","cells":[{"_uid":"be11a177-c394-4277-b50c-56e9b3925c05","text":"Power on and watch DIRECTV instantly","tooltip":"Pick up right where you left off by instantly loading the last channel that you watched.","contentType":"textAndTootip"},{"_uid":"055139d6-092a-478d-a3ad-1ba3b0b61995","contentType":"check"},{"_uid":"a11cd782-30b9-4c98-89b8-f348cad49ece","contentType":"empty"}]},{"_uid":"cc6ccea1-04cf-4ccf-acd2-9348100ca629","cells":[{"_uid":"0ed2ba2a-57c2-48ae-b3a7-421b0653a545","text":"How to watch","contentType":"text"},{"_uid":"38285b2e-d69f-432d-843b-77c5d5886551","text":"Connect to any TV with an HDMI port","contentType":"text"},{"_uid":"b76a5ea7-4daa-4594-a196-5a3828e42556","text":"Smart TVs, streaming devices, and mobile devices","tooltip":"\u003cdiv\u003e Compatible devices and browsers: \u003c/div\u003e \u003cul\u003e \u003cli\u003eAmazon Fire devices and TVs\u003c/li\u003e \u003cli\u003eGoogle/Android devices\u003c/li\u003e \u003cli\u003eChrome browser\u003c/li\u003e \u003cli\u003eApple TVs\u003c/li\u003e \u003cli\u003eApple phones and tablets\u003c/li\u003e \u003cli\u003eSafari browser\u003c/li\u003e \u003cli\u003eMicrosoft Edge\u003c/li\u003e \u003cli\u003eRoku devices\u003c/li\u003e \u003cli\u003eSamsung TVs (2017 and newer)\u003c/li\u003e \u003cli\u003eTelly TV\u003c/li\u003e \u003c/ul\u003e","contentType":"textAndTootip"}]},{"_uid":"0f68d4e4-2e04-4895-920f-32234d11bf83","cells":[{"_uid":"753cb3cd-38e9-4542-b3c0-ff2f7a470330","text":"Cost","contentType":"text"},{"_uid":"9c3a8cb4-0df4-4ed3-a062-2dbb3b0ab672","text":"First device included\u003cbr/\u003e$7/mo ea. addit’l","tooltip":"First leased device included with subscription. Additional leased devices available for $7/mo. per device.\u003cbr/\u003e\u003cbr/\u003eA one-time credit fee may be required in order to lease equipment based on credit verification.","contentType":"textAndTootip"},{"_uid":"a95c74ca-ff3a-459f-a7e3-3807afe29bf4","text":"Incl. with service","contentType":"text"}]}],"outerBorder":false,"stickyColumn":false,"stickyHeader":false,"equalColWidth":false,"verticalLines":false,"horizontalLines":false,"rowColorPattern":false,"enableTextUpdate":false}],"imagesGemini":[{"alt":"Gemini device and remote in front of a TV","_uid":"d8d43aa6-8673-4d8e-a3e6-6b14d66a770c","imageUrl":"/dtvassets/sales/pcp/imagery/gemini-learn-more-air-tv.jpg","imageClass":"imageSize","imageContent":"Get live TV, local channels and your favorite apps.","imageSubClass":"h3","imageContClass":"h3","imageSubContent":"Switch between live, recorded, and On Demand TV—or to apps like Max™, Netflix, or Prime Video—without missing a beat.*","subscriptionContent":"*Subscriptions required for 3\u003csup\u003erd\u003c/sup\u003e party providers. Disney+ and Hulu included with streaming device."},{"alt":"Person sitting on couch watching TV","_uid":"fb4ac5f9-a727-4425-ac04-7da44eca9c6d","imageUrl":"/dtvassets/sales/pcp/imagery/gemini-learn-more-livingroom-tv-mockup-larger-tv.jpg","imageUrl1":"https://www.directv.com/assets/content/ooadndhhbl/","imageClass":"imageSize","imageContent":"Universal voice remote powered by Google","imageSubClass":"fontBody2","imageContClass":"fontBody1","imageSubContent":"It’s a snap to use. Easily pair with most TVs and sound systems. Control live TV, apps, smart home devices*, and more with a single remote control.","imageContentLeft":"It’s a snap to use.","imageContentRight":"Voice commands control your TV and more","imageSubContentLeft":"Easily pair with most TVs and sound systems. Control live TV, apps, smart home devices*, and more with a single remote control.","subscriptionContent":"*Certain commands will depend on 3\u003csup\u003erd\u003c/sup\u003e party functionalities.","imageSubContentRight":"\"Is it going to rain today?\"\u003cbr/\u003e\"Launch Netflix\"\u003cbr/\u003e\"Play some music\"\u003cbr/\u003e\"Dim the lights\""},{"alt":"Gemini device displaying HDMI cable and measurements 1.9” x 3.7","_uid":"1db7ac4d-9e65-4de3-8ed0-74e0881fd04b","imageUrl":"/dtvassets/sales/pcp/imagery/gemini-learn-more-air-dimensions.jpg","imageContent":"Easy setup with a compact design","imageSubContent":"The latest Gemini Air device is an amazingly small 1.9” x 3.7”, fitting behind almost any TV. Enjoy easy self-setup in minutes—just sign up, plug into a power source, and make a single connection to your TV.*","subscriptionContent":"*Connects to a standard HDMI port. Power cord not shown."},{"alt":"TV displaying DIRECTV Streaming App","_uid":"812d2f0f-6bbc-446b-8337-8b7e78d3e98b","tooltip":"Req’s separate subscription for 3rd party apps. Restrictions apply. High speed internet connection req’d.","imageUrl":"/dtvassets/sales/pcp/imagery/gemini-learn-more-tv-image-directv-apps.jpg","imageContent":"Access to your favorite shows and apps","imageSubContent":"Watch live TV and enjoy thousands of streaming apps at your fingertips like MaxTM, Netflix, or Prime Video and more on Google Play* from inside the DIRECTV experience.","subscriptionContent":"*Google login required. Google is a trademark of Google LLC."},{"alt":"TV with image of an astronaut looking at a planet","_uid":"11421de3-cd0a-439c-8618-d128b58aaaab","flag":false,"tooltip":"Picture quality dependent on programming and TV compatibility.","imageUrl":"/dtvassets/sales/pcp/imagery/gemini-learn-more-4k-tv-space.jpg","imageContent":"Streaming in high-quality video","imageSubContent":"Get incredible 4k HD programming."},{"alt":"Living room TV and Dolby Atmos logo","_uid":"b77d1f52-f40a-4a5d-ab37-34af00e03be6","flag":false,"imageUrl":"/dtvassets/sales/pcp/imagery/gemini-learn-more-dolby-atmos.jpg","imageContent":"Surround sound for an amazing home theater experience","imageSubContent":"Dolby Atmos 5.1 enabled. Requires compatible audio receiver and speakers.\u003ca href='https://www.dolby.com/' target='_blank'\u003e Learn more at Dolby \u003c/a\u003e"},{"_uid":"21ae85b9-280a-435f-a620-56fe482d8ae7","flag":false,"imageClass":"imageSize","compareTable":{"id":"pcplearnMoreModal","_uid":"94c884e3-a66e-470e-ac28-a8ce1fe6ead4","type":"LEARNMOREMODAL","head1":"DIRECTV on Gemini Air","head2":"DIRECTV on other devices","rows":[{"_uid":"fdf55ca4-5e97-448f-b1e0-36f0b2f6e5b0","cells":[{"_uid":"46df66fd-93ed-4eb3-ba9c-8ce1801386b3","text":"Thousands of on-demand titles","tooltip":"Easily find, rent, or view free shows, movies, DIRECTV specials, and other titles whenever you want to watch.","contentType":"textAndTootip"},{"_uid":"a501eb71-c359-43a5-827b-b3660d810c3c","contentType":"check"},{"_uid":"016cb260-1d71-49a1-888b-98b4f05be313","contentType":"check"}]},{"_uid":"48997233-bdb0-4ce2-8c9c-43b2e1ff9164","cells":[{"_uid":"358cd72d-fe2d-40e1-9afd-763076c7cf93","text":"Access to live \u0026 local TV channels","contentType":"text"},{"_uid":"58c9ac42-3cdd-41f3-8878-51f64c804436","contentType":"check"},{"_uid":"959dca6b-9607-4ee2-81c0-f1dc0d4c9479","contentType":"check"}]},{"_uid":"0bd139c6-8fe9-4ef1-b520-ee6be83667a3","cells":[{"_uid":"85cd54af-7746-4d1a-8bdf-b3a994b618b0","text":"Unlimited recording hours","contentType":"text"},{"_uid":"973062b3-fccf-485b-9f47-cf1373a21edd","contentType":"check"},{"_uid":"